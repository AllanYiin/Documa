graft native
include scripts/build_manylinux_release.sh
include scripts/smoke_installed_release.py
include scripts/verify_release_artifacts.py
include scripts/package_release.py
include scripts/package_plugins.py
include docs/documa/install-0.9.0.md
include CHANGELOG.md
prune native/pdf/target
prune native/office/target
prune native/lingxi/target
recursive-include src/documa/_vendor/lingxi/assets *.bin
prune native/pdf/bindings/wasm/pkg-*
prune native/pdf/bindings/wasm/pkg
global-exclude __pycache__ *.py[cod]

prune native/pdf/fuzz/target
prune native/pdf/fuzz/corpus
prune native/pdf/fuzz/artifacts
prune native/pdf/tests/real-world/.private
exclude native/pdf/tests/real-world/manifest.local.toml

prune native/office/fuzz/target
prune native/office/fuzz/corpus
prune native/office/fuzz/artifacts
prune native/office/tmp
prune native/office/.local-corpus
prune native/office/fixtures/real-world
prune native/office/reports
