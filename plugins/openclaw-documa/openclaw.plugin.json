{
  "id": "documa",
  "name": "Documa",
  "version": "0.7.0",
  "description": "Adds Documa document-understanding tools to OpenClaw.",
  "icon": "https://raw.githubusercontent.com/AllanYiin/Documa/main/assets/documa-logo.png",
  "contracts": {
    "tools": [
      "documa_process",
      "documa_search_blocks",
      "documa_read_block",
      "documa_ingest",
      "documa_list_documents",
      "documa_index_collection",
      "documa_search_collection",
      "documa_doctor"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "documaCommand": {
        "type": "string",
        "description": "Documa CLI command to execute.",
        "default": "documa"
      }
    }
  },
  "skills": [
    "skills"
  ]
}

